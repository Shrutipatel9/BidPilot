# Copy to .env.local and fill in. Never commit the real .env.local file. Vite only exposes
# vars prefixed VITE_ to client code — never put a secret here, only public/client-safe values.

VITE_API_BASE_URL=http://localhost:8000

# External credential (public client ID, not a secret, but still not chosen yet) — Claude will
# ask for this alongside the backend GOOGLE_OAUTH_CLIENT_ID when Phase 0.3 is implemented.
VITE_GOOGLE_OAUTH_CLIENT_ID=
