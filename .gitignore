# Environment / secrets — real values never get committed, only .env.example files do
.env
.env.*
!.env.example
!*/.env.example

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
logs/

# Docker
docker-compose.override.yml

# Root-level Python/Node artifacts (frontend/ and backend/ have their own .gitignore for their trees)
__pycache__/
*.py[oc]
node_modules/
