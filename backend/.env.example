# Copy to .env and fill in. Never commit the real .env file.

# --- Environment ---
ENVIRONMENT=development

# --- Database (Phase 0.1/0.2) ---
# Local dev value once docker-compose.yml exists (Phase 0.1); no external account needed.
DATABASE_URL=postgresql+asyncpg://bidpilot:bidpilot@localhost:5432/bidpilot
# Separate DB used only by the backend test suite (docs/testing.md §2); created automatically
# by docker/postgres-init/01-create-test-db.sql the first time the postgres container starts.
TEST_DATABASE_URL=postgresql+asyncpg://bidpilot:bidpilot@localhost:5432/bidpilot_test

# --- Redis (Phase 0.1) ---
# Local dev value once docker-compose.yml exists; no external account needed.
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT (Phase 0.3) ---
# Generate a random value yourself, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth (Phase 0.3, FR-AUTH-02) ---
# External credential — do NOT fill this in speculatively. Claude will ask you for it,
# with setup steps (Google Cloud Console → APIs & Services → Credentials), when Phase 0.3
# is actually implemented.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Transactional email via SMTP (Phase 0.3, FR-AUTH-03: verification/password reset) ---
# External credential — ask the user when ready. For SendGrid: dashboard → Settings → SMTP
# Relay (host smtp.sendgrid.net, port 587, username "apikey", password = an API key from
# Settings → API Keys). Left blank on purpose: with SMTP_HOST unset and ENVIRONMENT=development,
# the backend logs email content to the console and returns a debug_link in API responses
# instead of failing, so auth/invite flows are fully testable before real SMTP is wired up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- S3 / MinIO file storage (Phase 1.1) ---
# Local dev (MinIO) value once docker-compose.yml exists; no external account needed for local dev.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=bidpilot-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- CORS / links ---
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
